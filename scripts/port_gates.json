    {
      "id": "diff_match_patch",
      "source": "examples/diff_match_patch",
      "port": "examples/diff_match_patch_rust",
      "indexer": "python",
      "published_graph": {
        "path": "byog_dmp",
        "mode": "mutable"
      },
      "checks": [
        {
          "name": "Python golden contracts",
          "command": [
            "{python}",
            "-m",
            "pytest",
            "examples/diff_match_patch/tests",
            "-q"
          ]
        }
      ]
    },
    {
      "id": "charset_normalizer",
      "source": "examples/charset_normalizer",
      "port": "examples/charset_normalizer_rust",
      "after": [
        "cjson"
      ],
      "indexer": "python",
      "published_graph": {
        "path": "byog_charset_normalizer",
        "mode": "mutable"
      },
      "symbols": [
        "api:from_bytes",
        "__main__:cli_detect"
      ],
      "contract_tests": {
        ".": "detection_contract.rs"
      },
      "run_binary": false,
      "checks": [
        {
          "name": "Rust/Python targeted parity suite",
          "command": [
            "{python}",
            "-m",
            "pytest",
            "examples/charset_normalizer_rust",
            "-q",
            "--tb=no"
          ]
        },
        {
          "name": "seeded live Python-oracle differential",
          "command": [
            "{python}",
            "examples/charset_normalizer_rust/tools/differential_harness.py",
            "--assert-clean"
          ]
        },
        {
          "name": "full examples pytest",
          "when": "full",
          "timeout_seconds": 1800,
          "command": [
            "{python}",
            "-m",
            "pytest",
            "examples",
            "-q",
            "--tb=no"
          ]
        },
        {
          "name": "documentation claims with frozen-source status",
          "when": "full",
          "successful_skip_marker": "PASS WITH SOURCE SKIPS",
          "skip_reason": "protected frozen SQLParse/isodate sources are absent; their recorded prose was still checked",
          "command": [
            "{python}",
            "scripts/check_doc_claims.py"
          ]
        },
        {
          "name": "generated local-evidence durability inventory",
          "when": "full",
          "command": [
            "{python}",
            "scripts/evidence_durability.py",
            "--check"
          ]
        },
        {
          "name": "full seeded Python-oracle differential",
          "when": "differential-full",
          "command": [
            "{python}",
            "examples/charset_normalizer_rust/tools/differential_harness.py",
            "--full",
            "--assert-clean"
          ]
        },
        {
          "name": "release scale harness",
          "when": "scale",
          "env": {
            "CN_SCALE": "1"
          },
          "command": [
            "{python}",
            "examples/charset_normalizer_rust/tools/scale_harness.py"
          ]
        }
      ]
    },
    {
      "id": "cjson",
      "source": "examples/cjson",
      "port": "examples/cjson_rust",
      "indexer": "c",
      "published_graph": {
        "path": "byog_cjson",
        "mode": "mutable"
      },
      "symbols": [
        "runner:trace_step",
        "cJSON:cJSON_Delete",
        "runner:emit_raw"
      ],
      "type_context": {
        "clang_type_uses": true,
        "depth": 2,
        "max_type_edges": 50,
        "max_type_observations": 5,
        "requirements": [
          {
            "symbol": "cJSON:cJSON_Delete",
            "direction": "dependencies",
            "require_nonempty": true,
            "allow_truncation": false
          }
        ]
      },
      "checks": [
        {
          "name": "header-derived API audit",
          "command": [
            "{python}",
            "examples/cjson/tools/api_surface_audit.py",
            "--check"
          ]
        },
        {
          "name": "C oracle, ASan, and compiler-rejection locations",
          "tools": [
            "c_compiler",
            "rustc"
          ],
          "command": [
            "{python}",
            "-m",
            "pytest",
            "examples/cjson/tests/test_cjson_extract.py",
            "examples/cjson/tests/test_cjson_parse_contract.py",
            "-q",
            "-rs"
          ]
        },
        {
          "name": "Miri ownership properties",
          "when": "full",
          "tools": [
            "miri"
          ],
          "cwd": "examples/cjson_rust",
          "command": [
            "cargo",
            "+nightly",
            "miri",
            "test",
            "--test",
            "ownership_props"
          ]
        }
      ]
    },
    {
      "id": "jsonpatch",
      "kind": "gap",
      "source": "examples/jsonpatch",
      "indexer": "python",
      "published_graph": {
        "path": "byog_jsonpatch",
        "mode": "mutable"
      },
      "gap": "The RFC 6902 apply contract is source-only (25 golden cases, published byog_jsonpatch graph); no Rust port exists. Retired as the v2 ablation target after the closure boundary in PROVENANCE.md, and kept as the registry-dispatch diagnostic case rather than a port."
    },
    {
      "id": "humanize",
      "kind": "gap",
      "source": "examples/humanize",
      "indexer": "python",
      "published_graph": {
        "path": "byog_humanize",
        "mode": "mutable"
      },
      "gap": "The bounded Python number-formatting contract exists, but there is no Rust port directory or Rust golden consumer; no port evidence can be claimed."
    },
    {
      "id": "isodate",
      "kind": "gap",
      "source": "examples/isodate",
      "indexer": "python",
      "published_graph": {
        "path": "byog_isodate",
        "mode": "frozen",
        "reason": "Closed ablation_v3 experiment evidence uses an intentionally older extractor and is never health-reindexed."
      },
      "gap": "The duration contract is source-only; no Rust port exists. Its archived ablation_v3 graph/experiment is deliberately not indexed or run by this gate."
    }
  ],
  "aggregate_checks": [
    {
      "name": "published mutable-graph health",
      "when": "full",
      "successful_skip_marker": "PASS WITH LOCAL ARTIFACT SKIPS",
      "skip_reason": "one or more mutable published graphs are absent locally; source-evidence profiles still ran from Git",
      "command": [
        "{python}",
        "scripts/published_graph_health.py",
        "--check"
      ]
    }
  ]
}
