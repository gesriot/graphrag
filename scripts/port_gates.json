{
  "schema_version": 1,
  "required_source_gaps": [
    "humanize",
    "isodate",
    "jsonpatch"
  ],
  "ports": [
    {
      "id": "mini_game",
      "source": "examples/mini_game",
      "port": "examples/mini_game_rust",
      "indexer": "python",
      "published_graph": {
        "path": "byog_mini_game",
        "mode": "mutable"
      },
      "symbols": [
        "sim:run_simulation",
        "physics:update_player",
        "main:run"
      ],
      "checks": [
        {
          "name": "Python golden trace contract",
          "command": [
            "{python}",
            "-m",
            "pytest",
            "examples/mini_game/tests/test_sim.py",
            "-q"
          ]
        }
      ]
    },
    {
      "id": "mini_lang",
      "source": "examples/mini_lang",
      "port": "examples/mini_lang_rust",
      "indexer": "python",
      "published_graph": {
        "path": "byog_mini_lang",
        "mode": "mutable"
      },
      "checks": [
        {
          "name": "Python golden contract",
          "command": [
            "{python}",
            "-m",
            "pytest",
            "examples/mini_lang/tests/test_contract.py",
            "-q"
          ]
        }
      ]
    },
    {
      "id": "jsmn",
      "source": "examples/jsmn",
      "port": "examples/jsmn_rust",
      "indexer": "c",
      "published_graph": {
        "path": "byog_jsmn",
        "mode": "mutable"
      },
      "checks": [
        {
          "name": "C graph and golden-oracle contract",
          "tools": [
            "c_compiler"
          ],
          "command": [
            "{python}",
            "-m",
            "pytest",
            "examples/jsmn/tests/test_c_extract.py",
            "examples/jsmn/tests/test_jsmn_parse_contract.py",
            "-q",
            "-rs"
          ]
        }
      ]
    },
    {
      "id": "inih",
      "source": "examples/inih",
      "port": "examples/inih_rust",
      "indexer": "c",
      "published_graph": {
        "path": "byog_inih",
        "mode": "mutable"
      },
      "symbols": [
        "ini:ini_parse",
        "ini:ini_parse_string",
        "ini:ini_parse_stream"
      ],
      "type_context": {
        "clang_type_uses": true,
        "depth": 2,
        "max_type_edges": 50,
        "max_type_observations": 5,
        "requirements": [
          {
            "symbol": "ini:ini_parse",
            "direction": "dependencies",
            "require_nonempty": true,
            "allow_truncation": false
          }
        ]
      },
      "checks": [
        {
          "name": "C graph and golden-oracle contract",
          "tools": [
            "c_compiler"
          ],
          "command": [
            "{python}",
            "-m",
            "pytest",
            "examples/inih/tests",
            "-q",
            "-rs"
          ]
        }
      ]
    },
    {
      "id": "sqlparse",
      "source": "examples/sqlparse",
      "port": "examples/sqlparse_rust",
      "indexer": "python",
      "published_graph": {
        "path": "byog_sqlparse",
        "mode": "mutable"
      },
      "checks": [
        {
          "name": "Python golden contract",
          "command": [
            "{python}",
            "-m",
            "pytest",
            "examples/sqlparse/tests/test_split_contract.py",
            "-q"
          ]
        },
        {
          "name": "Inherited-member runtime audit (SQLParse + semantic_version)",
          "command": [
            "{python}",
            "scripts/inherited_member_runtime_audit.py",
            "--check"
          ]
        },
        {
          "name": "Initializer public-API runtime audit (all Python targets)",
          "command": [
            "{python}",
            "scripts/init_api_runtime_audit.py",
            "--check"
          ]
        },
        {
          "name": "Re-export identity and trace-reachability audit (all Python targets)",
          "command": [
            "{python}",
            "scripts/reexport_reachability_audit.py",
            "--check"
          ]
        }
      ]
    },
    {
      "id": "semantic_version",
